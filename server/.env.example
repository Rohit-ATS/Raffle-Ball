# Copy to .env for local development. Every value here is optional:
# with no DATABASE_URL the server uses an in-memory store, which is why the test suite and a
# bare `npm start` work on a clean machine.

# Postgres connection string. Render injects this automatically in production.
# DATABASE_URL=postgres://riftrally:password@localhost:5432/riftrally

# Secret used to sign player tokens. Without it the server generates a random one per boot,
# which means sessions stop working on restart - fine locally, not fine in production.
# JWT_SECRET=change-me-to-something-long-and-random

# Port to listen on. Render sets this itself.
# PORT=8080
